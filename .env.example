# .env にコピーして使う。バックエンド（compose / Cloud Run）が読む。

# 必須。Gemini の問題生成・採点・埋め込みに使う。
GOOGLE_API_KEY=your_api_key_here

# CORS。完全一致で許可するオリジンをカンマ区切りで指定する。
# 未設定時のデフォルトは http://localhost:5173,http://localhost:4173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# CORS。Vercel のプレビューデプロイは動的ドメインなので正規表現で受ける。
# 完全一致だけでは足りないため。デフォルトなし（未設定なら regex 判定を行わない）。
# 例: ALLOWED_ORIGIN_REGEX=https://math-app-[a-z0-9-]+\.vercel\.app
# ALLOWED_ORIGIN_REGEX=

# 公開デモ用の共有パスコード。X-App-Passcode ヘッダで要求する。
# 未設定・空なら認証なしで動作する（開発時はこの状態のままでよい）。
# /health と CORS プリフライト(OPTIONS)は常に免除される。
# APP_PASSCODE=

# IPごとのレートリミット（1分あたり）。0 で無効。未設定時のデフォルトは 20。
# インメモリかつプロセス単位なので、インスタンスが増えると実効上限も増える。
# RATE_LIMIT_PER_MINUTE=20

# ログレベル。未設定時は INFO。
# LOG_LEVEL=INFO
